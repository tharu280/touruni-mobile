EXPO_PUBLIC_BACKEND_URL=https://your-backend.example.com

# Required by Android release/development builds that render Google Maps.
# Restrict this key to the Android Maps SDK and your app package/signing certificate.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_android_maps_sdk_key

# ── Firebase (IoT live data) ──────────────────────────────────────────────────
# Required for the IoT screens. Copy from Firebase console -> Project settings
# -> Your apps -> SDK setup and configuration. Names must match the keys read in
# src/firebase/firebaseConfig.ts exactly.
# Only API_KEY, DATABASE_URL and PROJECT_ID gate firebaseConfigured; the rest are
# needed for FCM push and Analytics.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
